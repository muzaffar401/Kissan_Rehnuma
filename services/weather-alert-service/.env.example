# ── Application ──
APP_NAME=weather-alert-service
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Server ──
HOST=0.0.0.0
PORT=8004

# ── Database (SHARED with user-auth-service) ──
# Same DB — weather service reads the 'farmers' table created by auth service
# Owns its own tables: farmer_locations, weather_snapshots, alerts_sent, device_tokens
DATABASE_URL=postgresql://postgres:Commtel%40123@localhost:5432/Farmers

# ── JWT (MUST match user-auth-service) ──
JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256

# ── Weather Provider (Open-Meteo — free, no key needed) ──
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
HTTP_TIMEOUT_SECONDS=10

# ── Cache & Forecast ──
WEATHER_CACHE_MINUTES=30
FORECAST_HOURS=48

# ── Background Scheduler ──
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=30

# ── Risk Thresholds (testing ke liye adjust karein) ──
FROST_TEMP_C=2
HEATWAVE_TEMP_C=45
HEAVY_RAIN_TOTAL_MM=15
HIGH_WIND_KMH=40

# ── Optional: LLM Advisory (OpenRouter/OpenAI) ──
# Nahi diya to static Roman-Urdu advisories use hongi
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Optional: Twilio SMS ──
# Nahi diya to SMS sirf log me aayega
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Optional: Firebase Push Notifications ──
# Nahi diya to push sirf log me aayega
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=