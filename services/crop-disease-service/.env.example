# ── Application ──
APP_NAME=crop-disease-service
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ──
# NOTE: If password contains @ or special chars, URL-encode them (@ → %40)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/kissan_crop_disease
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ── OpenRouter (Vision LLM) ──
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VISION_MODEL=openai/gpt-4o
VISION_TEMPERATURE=0.1
VISION_MAX_TOKENS=2048
VISION_TIMEOUT=120

# ── Confidence Gate ──
CONFIDENCE_THRESHOLD=0.70

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=kissan-rehnuma/crop-scans

# ── LangSmith (Observability) ──
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=crop-disease-service

# ── Image Constraints ──
MAX_IMAGE_SIZE_MB=10
MIN_IMAGE_WIDTH=224
MIN_IMAGE_HEIGHT=224
# Comma-separated: image/jpeg,image/png,image/webp
ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp
