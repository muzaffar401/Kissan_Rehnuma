# ============================================================
# Kissan Rehnuma — Docker Compose environment
# ============================================================
# Copy this file to .env (repo root) and fill in real values:
#   cp .env.docker.example .env
#
# .env is gitignored — secrets never reach the repository.
# Required vars are enforced by docker-compose.yml (:? checks).
# ============================================================

# ── PostgreSQL (container) ─────────────────────────────────
# Strong password for the local Postgres superuser 'kissan'.
POSTGRES_PASSWORD=change-me-strong-random-password

# ── JWT (MUST be identical across gateway/user-auth/weather) ──
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=change-me-openssl-rand-hex-32

# ── Brevo transactional email (OTP delivery) ───────────────
# v3 API key (starts with xkeysib-) from Brevo dashboard.
BREVO_API_KEY=
# Verified sender email in Brevo (Senders & IP → Senders)
BREVO_SENDER_EMAIL=ahmedmuzaffar125@gmail.com
BREVO_SENDER_NAME=Kissan Rehnuma

# ── OpenRouter (vision LLM + weather advisories) ───────────
OPENROUTER_API_KEY=

# ── Cloudinary (image storage for disease scans) ───────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Market-rate admin (optional) ───────────────────────────
ADMIN_API_KEY=

# ── API Gateway ────────────────────────────────────────────
# Comma-separated allowed origins. Include the Vercel frontend
# URL and the VPS IP/domain.
CORS_ORIGINS=https://mobile-web-app-wine.vercel.app,http://80.225.254.112

# ── Optional tuning ────────────────────────────────────────
VISION_MODEL=google/gemini-2.5-flash
LLM_MODEL=google/gemini-2.5-flash
SCHEDULER_ENABLED=true
